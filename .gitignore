# ------------------------------------
# 1. Monorepo Cleanup (Crucial)
# ------------------------------------
# Prevents the temporary .gitignore files from being tracked
/mobile/.gitignore
/backend/.gitignore
/web/.gitignore

# ------------------------------------
# 2. General / OS / IDE Ignores
# ------------------------------------
# OS Specific
.DS_Store
Thumbs.db
*.pem

# VS Code
.vscode/

# IntelliJ IDEA
.idea
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ------------------------------------
# 3. Java / Spring Boot / Gradle Ignores (Backend)
# ------------------------------------
HELP.md
# Gradle builds
.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Compiled Java output
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/


# ------------------------------------
# 4. React Native / Expo Ignores (Frontend)
# ------------------------------------
# Dependencies and debug
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*

# Expo/Metro build output and temporary files
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Generated Native folders (Android/iOS)
/ios
/android

# Native-related files (Keys, certs, temp files)
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Local environment files and compiled artifacts
.env*.local
mobile/.env
# backend/.env holds DB_PASS and DO_SPACES_* and is read by the bootRun task
# in backend/build.gradle - it must never be committed.
backend/.env
*.tsbuildinfo

# H2 Database (local dev only)
*.mv.db
*.trace.db
backend/data/

# ------------------------------------
# 5. React / Vite Ignores (Web)
# ------------------------------------
# node_modules/, dist/ and *.tsbuildinfo are already covered above.
web/.env
*.log

# Offline OCR assets for the ID scanner (TODO-13). Fetched by
# web/scripts/fetch-ocr-assets.mjs from node_modules and from a pinned,
# checksum-verified tessdata_fast tag, on every build. ~14 MB of engine and
# language model that never changes - a build step, not a commit, because a
# binary blob in git history is permanent (see TODO-24).
web/public/tesseract/

# ------------------------------------
# 6. Terraform (infra/)
# ------------------------------------
# State holds every value Terraform read or generated, the database password
# among them. .terraform.lock.hcl is deliberately NOT ignored: it pins provider
# versions and hashes, so CI resolves exactly what you resolved.
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/.terraform.tfstate.lock.info
infra/**/*.tfvars
infra/**/*.tfvars.json
!infra/**/*.tfvars.example
infra/**/*.tfplan
infra/**/tfplan
infra/**/crash.log
infra/**/crash.*.log

# ------------------------------------
# 7. Vercel CLI (web/)
# ------------------------------------
# `vercel link` writes projectId and orgId here. CI passes those as
# VERCEL_PROJECT_ID / VERCEL_ORG_ID instead, so the linked directory is a
# local convenience and never belongs in the repo.
.vercel/
